WHITESPACE = _{ " " | "\t" | "\r" }
COMMENT = _{ "%%" ~ (!"\n" ~ ANY)* }
end = _{ ("\n" | ";")+ }
diagram = { SOI ~ end* ~ ^"erDiagram" ~ (end+ ~ (statement ~ (end+ | &EOI))* )? ~ EOI }
statement = _{ direction | relation | entity }
direction = { "direction" ~ ("TB" | "BT" | "LR" | "RL") }
name = @{ quoted | (! (" " | "\t" | "\r" | "\n" | ";" | "{" | "}" | ":" | "|" | "[" | "]" | "\"" | "%%") ~ ANY)+ }
quoted = @{ "\"" ~ (! ("\"" | "\n") ~ ANY)+ ~ "\"" }
entity = { name ~ ("{" ~ "\n"* ~ (attribute ~ "\n"*)* ~ "}")? }
relation = { name ~ left ~ line ~ right ~ name ~ ":" ~ label }
left = @{ "||" | "|o" | "}o" | "}|" }
right = @{ "||" | "o|" | "o{" | "|{" }
line = { "--" | ".." }
label = @{ comment | (! ("\n" | ";" | "%%" | "\"") ~ ANY)+ }
attribute = { word ~ attr_name ~ keys? ~ comment? }
word = @{ ALPHABETIC ~ ((ALPHABETIC | NUMBER) | "_" | "-" | "(" | ")" | "[" | "]")* }
attr_name = @{ "*"? ~ ALPHABETIC ~ ((ALPHABETIC | NUMBER) | "_" | "-" | "(" | ")" | "[" | "]")* }
keys = { key ~ ("," ~ key)* }
key = @{ "PK" | "FK" | "UK" }
comment = @{ "\"" ~ (! ("\"" | "\n") ~ ANY)* ~ "\"" }
